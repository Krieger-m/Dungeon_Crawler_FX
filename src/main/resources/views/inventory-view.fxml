<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>



<VBox fx:id="main_container" alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/24"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.krieger.dungeon_adventure.InventoryController">
  <padding>
    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
  </padding>
   <children>
      <ImageView fx:id="image_container" fitHeight="800.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/inventory_bg.jpg" />
         </image>
      </ImageView>
      <HBox fx:id="button_container" alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
         <children>
            <Button fx:id="useButton" mnemonicParsing="false" text="Use Item" />
            <Button fx:id="equipButton" mnemonicParsing="false" text="Equip Item" />
            <Button fx:id="combineButton" mnemonicParsing="false" text="Combine Items" />
            <Button fx:id="inspectButton" mnemonicParsing="false" text="Inspect Item" />
            <Button fx:id="backButton" mnemonicParsing="false" text="Back" />
         </children>
      </HBox>
   </children>
</VBox>

        <!-- <?export javafx.scene.layout.VBOX?> -->
